#version 450
// Compute test: out[i] = 3 * i + k. The storage buffer is at binding 23 (kMaxSampledImages + 1).
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 23) buffer Out { uint data[]; };
layout(push_constant) uniform Push { uint k; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    data[i] = 3u * i + pc.k;
}
